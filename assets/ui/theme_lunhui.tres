Button/styles/pressed = SubResource("btn_pressed")
Label/colors/font_color = Color(0.196078, 0.180392, 0.14902, 1)
Panel/styles/panel = SubResource("panel_bg")
PanelContainer/styles/panel = SubResource("panel_bg")
TabContainer/colors/font_hovered_color = Color(0.0901961, 0.0823529, 0.0588235, 1)
TabContainer/colors/font_selected_color = Color(0.976471, 0.945098, 0.886275, 1)
TabContainer/colors/font_unselected_color = Color(0.196078, 0.180392, 0.14902, 1)
TabContainer/styles/panel = SubResource("blank")
TabContainer/styles/tab_hovered = SubResource("tab_hovered")
