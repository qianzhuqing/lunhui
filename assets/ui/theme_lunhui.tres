[gd_resource type="Theme" load_steps=7 format=3]

; 「墨色江湖」UI 主题（设计 15 §4.4）。
; 配色、按钮四态、两档字号（默认 12／按钮与标题 16）在这里；面板底是**九宫格贴图**
; （`assets/ui/common/panel_bg.png`，15 §4.4：切图 32×32、四角 8×8 不拉伸、中心 16×16 可平铺）。
; **色值不许在别处再写一遍**——代码里要强调色就引用这里的 `Theme` 结果（见 `框架说明.md` 决策 375）。

[ext_resource type="Texture2D" uid="uid://d011qafxoxwi5" path="res://assets/ui/common/panel_bg.png" id="1_panel"]

[sub_resource type="StyleBoxFlat" id="btn_normal"]
content_margin_left = 4.0
content_margin_top = 9.0
content_margin_right = 4.0
content_margin_bottom = 9.0
bg_color = Color(0.172549, 0.196078, 0.211765, 1)

[sub_resource type="StyleBoxFlat" id="btn_hover"]
content_margin_left = 4.0
content_margin_top = 9.0
content_margin_right = 4.0
content_margin_bottom = 9.0
bg_color = Color(0.227451, 0.258824, 0.278431, 1)

[sub_resource type="StyleBoxFlat" id="btn_pressed"]
content_margin_left = 4.0
content_margin_top = 9.0
content_margin_right = 4.0
content_margin_bottom = 9.0
bg_color = Color(0.0901961, 0.101961, 0.109804, 1)

[sub_resource type="StyleBoxFlat" id="btn_disabled"]
content_margin_left = 4.0
content_margin_top = 9.0
content_margin_right = 4.0
content_margin_bottom = 9.0
bg_color = Color(0.101961, 0.101961, 0.101961, 1)

; 八个浮层共用这一张底板：四角固定、四边与中心按 TILE 铺（`axis_stretch_*`＝1），
; 所以任意长宽的浮层都不会把边角拉变形。内边距仍留 10px，内容不会压到石纹上。
[sub_resource type="StyleBoxTexture" id="panel_bg"]
content_margin_left = 10.0
content_margin_top = 10.0
content_margin_right = 10.0
content_margin_bottom = 10.0
texture = ExtResource("1_panel")
texture_margin_left = 8.0
texture_margin_top = 8.0
texture_margin_right = 8.0
texture_margin_bottom = 8.0
axis_stretch_horizontal = 1
axis_stretch_vertical = 1

[resource]
default_font_size = 12
Button/colors/font_color = Color(0.847059, 0.823529, 0.768627, 1)
Button/colors/font_disabled_color = Color(0.352941, 0.352941, 0.333333, 1)
Button/colors/font_hover_color = Color(1, 1, 1, 1)
Button/colors/font_pressed_color = Color(0.847059, 0.823529, 0.768627, 1)
Button/font_sizes/font_size = 16
Button/styles/disabled = SubResource("btn_disabled")
Button/styles/hover = SubResource("btn_hover")
Button/styles/normal = SubResource("btn_normal")
Button/styles/pressed = SubResource("btn_pressed")
Label/colors/font_color = Color(0.847059, 0.823529, 0.768627, 1)
Panel/styles/panel = SubResource("panel_bg")
PanelContainer/styles/panel = SubResource("panel_bg")
