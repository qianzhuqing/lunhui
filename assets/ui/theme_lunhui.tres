[resource]
default_font_size = 12
; 字体：主字体（简体）＋ 两份回退，见文件头的 2026-10-11 那段
default_font = SubResource("font_main")
; —— 观感层的自定义色（`UiKit/colors/<名>`）：卡片、标题条、小节、刻度条都从这儿取。
; 15 §4.4 的色值**只写在这一份**里（决策 375）；换一整套皮肤＝换这一个文件。
UiKit/colors/ink = Color(0.196078, 0.180392, 0.14902, 1)
UiKit/colors/ink_dim = Color(0.360784, 0.333333, 0.290196, 1)
UiKit/colors/ink_off = Color(0.541176, 0.501961, 0.439216, 1)
UiKit/colors/gold = Color(0.784314, 0.635294, 0.290196, 1)
UiKit/colors/cinnabar = Color(0.658824, 0.196078, 0.164706, 1)
; 朱红的主按钮／高亮态（示意图 `.lu-btn-main`／`.lu-fn.is-on` 的两端色，`StyleBoxFlat` 画不了渐变，取中值那一档）
UiKit/colors/cinnabar_hot = Color(0.721569, 0.25098, 0.184314, 1)
UiKit/colors/cinnabar_deep = Color(0.490196, 0.12549, 0.0980392, 1)
; 朱红实底上那一档字色（`.lu-fn.is-on` 的 `#F9F1E2`）
UiKit/colors/on_text = Color(0.976471, 0.945098, 0.886275, 1)
UiKit/colors/line = Color(0.658824, 0.603922, 0.494118, 1)
; 面板内的分隔细线（`.lu-panel-h` 的下边线：`rgba(60,55,45,.25)`）
UiKit/colors/line_soft = Color(0.235294, 0.215686, 0.176471, 0.25)
UiKit/colors/paper = Color(0.929412, 0.890196, 0.796078, 1)
; 按钮／格子的亮端（`.lu-btn` 的 `#F7F0DE`）与暗端（`#E2D7BB`）
UiKit/colors/paper_bright = Color(0.968627, 0.941176, 0.870588, 1)
UiKit/colors/paper_dark = Color(0.886275, 0.843137, 0.733333, 1)
; 顶栏：唯一的大块深色（15 §4.4）——`.lu-topbar` 的 `#211F1A → #16140F` 取中值
UiKit/colors/topbar_bg = Color(0.109804, 0.101961, 0.0862745, 1)
UiKit/colors/topbar_text = Color(0.94902, 0.901961, 0.768627, 1)
UiKit/colors/topbar_dim = Color(0.796078, 0.729412, 0.627451, 1)
UiKit/colors/topbar_money = Color(0.913725, 0.776471, 0.564706, 1)
; 底栏：宣纸渐变 `#F3EBD7 → #DED2B6` 取中值；比面板亮一点点就够，不许比面板更亮（15 §4.4）
UiKit/colors/bottombar_bg = Color(0.909804, 0.870588, 0.772549, 1)
; 三支点色（水墨五行：靛青为水、赭石为木、青碧为玉）——套装／被动／传闻那些小标签用
UiKit/colors/indigo = Color(0.2, 0.337255, 0.415686, 1)
UiKit/colors/ochre = Color(0.541176, 0.352941, 0.235294, 1)
UiKit/colors/jade = Color(0.298039, 0.478431, 0.384314, 1)
; 状态条三色是**信息色**（15 §4.4：换肤不动它们）：气血／架势（＝gold）／内力
UiKit/colors/hp = Color(0.545098, 0.180392, 0.180392, 1)
UiKit/colors/mp = Color(0.243137, 0.431373, 0.541176, 1)
; 浮层背板：比面板底再沉一档的旧纸（面板是「一张更亮的纸」，靠这层与 1px 描边分开）。
; **它是单一出处**——`UiKit.paint_backdrop()` 按名字找到浮层的 `Backdrop` 刷上去，
; 面板的 `.tscn` 里不再各写一份色值。
UiKit/colors/backdrop = Color(0.85098, 0.811765, 0.705882, 0.97)
; 战斗战场那一屏的色（15 §4.4 的「战斗战场底／战场地形剪影／我方轮廓光／敌方轮廓光」三行）：
; 全游戏唯一压暗的一屏（22 §1.5）。**轮廓光是「亮描边」**——暗底上墨色描边等于没描边。
UiKit/colors/stage_top = Color(0.164706, 0.164706, 0.180392, 1)
UiKit/colors/stage_mid = Color(0.105882, 0.105882, 0.121569, 1)
UiKit/colors/stage_bottom = Color(0.0666667, 0.0666667, 0.0784314, 1)
UiKit/colors/stage_ridge = Color(0.117647, 0.117647, 0.133333, 1)
UiKit/colors/rim_ally = Color(0.941176, 0.905882, 0.823529, 1)
UiKit/colors/rim_foe = Color(0.556863, 0.592157, 0.639216, 1)
; 战场上的字（名字／数值）：比纸白冷一点，免得跟轮廓光抢
UiKit/colors/stage_text = Color(0.956863, 0.92549, 0.85098, 1)
UiKit/colors/stage_dim = Color(0.85098, 0.803922, 0.698039, 1)
; 头顶条／刻度格的底槽（半透明黑，压在暗底上）
UiKit/colors/track = Color(0, 0, 0, 0.55)
; 结算面板的压暗底（22 §1.6 第八版）：整块面板压在这一层上；比 `track` 浅一档，还要看得见底下的战场
UiKit/colors/settle_dim = Color(0.039216, 0.035294, 0.031373, 0.66)
; 结算面板的背板：**暗底**（不用宣纸那件九宫格）——它长在战斗这一屏上（22 §1.5 全游戏唯一压暗的一屏），
; 金色标题与战场字色都压得住；比 `stage_mid` 再深一点、留一点透，别把战场切得太生硬
UiKit/colors/settle_panel = Color(0.086275, 0.082353, 0.078431, 0.94)
Button/colors/font_color = Color(0.196078, 0.180392, 0.14902, 1)
Button/colors/font_disabled_color = Color(0.541176, 0.501961, 0.439216, 1)
Button/colors/font_hover_color = Color(0.0901961, 0.0823529, 0.0588235, 1)
Button/colors/font_pressed_color = Color(0.0901961, 0.0823529, 0.0588235, 1)
Button/font_sizes/font_size = 12
