# Godot 4+ specific ignores
.godot/
/android/

# 构建期生成的配置表资源（CSV 是唯一数值源，见 docs/dev/框架说明.md）
data/generated/

# Godot 把 data/tables/*.csv 当「翻译表」导入（csv_translation），会在同目录按列生成
# *.translation、并按表生成 *.import —— 它们是导入产物、构建期一律不读（构建读原始 CSV）。
# 不忽略的话，`sync_to_git.bat` 的 `git add .` 会把 290 多个文件扫进仓库（见框架说明决策 191／195）。
data/tables/*.translation
data/tables/*.import

# headless 自检日志
.logs/

# 本地安装的 Codex 技能（`.agents/skills/`）：第三方 MIT 技能库，只供本机使用，
# 不进仓库——入库靠 `sync_to_git.bat` 的 `git add .`，不忽略就会被整包提交进去。
# 想让团队共享这些技能时，删掉这一行即可。
.agents/

# OS generated files
.DS_Store
Thumbs.db
